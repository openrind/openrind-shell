{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openrind Desktop",
  "version": "0.13.3",
  "identifier": "com.differentai.openrind-desktop",
  "build": {
    "beforeDevCommand": "node ./scripts/tauri-before-dev.mjs",
    "beforeBuildCommand": "node ./scripts/tauri-before-build.mjs",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Openrind Desktop",
        "width": 1180,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecars/versions.json": "versions.json"
    },
    "externalBin": [
      "sidecars/opencode",
      "sidecars/openrind-desktop-server",
      "sidecars/openrind-desktop-orchestrator",
      "sidecars/chrome-devtools-mcp"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "openrind-desktop"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwNDdCNTAwMTcxNUUxQTQKUldTazRSVVhBTFZIVUpNRi9OQnNRaElZY1NUWUQxS1ZJOTFUeUdPd2d6ZnFmMW5QV2xJQ1hXTTkK",
      "endpoints": [
        "https://github.com/openrind/openrind-shell/releases/latest/download/latest.json"
      ]
    }
  }
}
